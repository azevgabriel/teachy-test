enum PlanningGranularity {
  ANNUAL
  SEMESTER
  TRIMESTER
  BIMONTHLY
  MONTHLY
  WEEKLY
  DAILY
  CUSTOM

  @@map("planning_granularity")
}

model Planning {
  id                   String                  @id @default(uuid())
  schoolId             String?                 @map("school_id")
  school               School?                 @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  sessionId            String                  @map("session_id")
  session              Session                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  applicationYearId    String?                 @map("application_year_id")
  applicationYear      ApplicationYear?        @relation(fields: [applicationYearId], references: [id], onDelete: SetNull)
  curricularComponents CurricularComponent[]
  startAt              DateTime?               @map("start_at")
  endAt                DateTime?               @map("end_at")
  granularity          PlanningGranularity?
  blocks               PlanningBlock[]
  learningObjectives   LearningObjective[]
  metadataValues       PlanningMetadataValue[]
  evaluations          Evaluation[]
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@map("plannings")
}
